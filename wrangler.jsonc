{
  "name": "jowam-coffee-roasters",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "PRODUCTS_KV",
      // Create with: npx wrangler kv namespace create PRODUCTS_KV, then paste the id here.
      "id": "REPLACE_WITH_PRODUCTS_KV_ID",
    },
  ],
  "ratelimits": [
    {
      "name": "ORDER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
}
