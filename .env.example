# Copy to .env (git-ignored) and fill in. Read by `npm run dev`. Production uses `wrangler secret put`.
SHEET_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
SHEET_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Server-only Resend key (sending access, restricted to jowamroasters.com). Never prefix it with VITE_.
# Production: npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_SENDING_KEY

# Public Umami analytics settings, baked into the browser bundle at build time. Leave either
# blank and no tracking script loads (keeps local dev and previews out of the stats).
VITE_UMAMI_SCRIPT_URL=https://umami.mawirab.com/script.js
VITE_UMAMI_WEBSITE_ID=REPLACE_WITH_UMAMI_WEBSITE_ID
